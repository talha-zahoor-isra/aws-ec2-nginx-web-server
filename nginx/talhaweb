server {
    server_name talhaweb.redirectme.net;

    root /var/www/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/talhaweb.redirectme.net/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/talhaweb.redirectme.net/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = talhaweb.redirectme.net) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name talhaweb.redirectme.net;
    return 404; # managed by Certbot


}